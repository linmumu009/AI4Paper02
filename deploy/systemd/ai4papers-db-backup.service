[Unit]
Description=AI4Papers verified SQLite backup
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/projects/ArxivPaper4/Sever
ExecStart=/usr/bin/python3 /projects/ArxivPaper4/Sever/scripts/backup_databases.py --retention-count 3
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
