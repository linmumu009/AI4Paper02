# Install as /etc/ai4papers/sms.env with owner root:root and mode 0600.
# Never place real credentials in this repository.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Optional overrides; omit these lines to use Sever/config/sms_config.py defaults.
# AI4PAPERS_SMS_ENDPOINT=dypnsapi.aliyuncs.com
# AI4PAPERS_SMS_SIGN_NAME=
# AI4PAPERS_SMS_TEMPLATE_CODE=
# AI4PAPERS_SMS_SCHEME_NAME=
# AI4PAPERS_SMS_COUNTRY_CODE=86
# AI4PAPERS_SMS_MINUTES=5
# AI4PAPERS_SMS_INTERVAL=60
# AI4PAPERS_SMS_CODE_LENGTH=6
# AI4PAPERS_SMS_CODE_TYPE=1
# AI4PAPERS_SMS_CODE_PARAM_NAME=code
# AI4PAPERS_SMS_MIN_PARAM_NAME=min
# AI4PAPERS_SMS_VERIFY_TOKEN_TTL=600
